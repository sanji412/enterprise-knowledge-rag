# Docker Compose environment template
# Copy to docker/.env and customize values before running compose.

# Loopback-only binding and conflict-free host ports (container ports remain 8000 / 6379 / 6333)
BIND_HOST=127.0.0.1
APP_PORT=8100
REDIS_HOST_PORT=16379
QDRANT_HOST_PORT=16333

# Optional registry mirrors for restricted networks. Keep blank to use Docker Hub.
# NODE_IMAGE=docker.m.daocloud.io/library/node:20-bookworm-slim
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.11-slim
# DEBIAN_MIRROR=https://mirrors.aliyun.com/debian
# DEBIAN_SECURITY_MIRROR=https://mirrors.aliyun.com/debian-security
# HF_ENDPOINT=https://hf-mirror.com
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
# For the Aliyun PyTorch wheel mirror, set both values below.
# PYTORCH_FIND_LINKS=https://mirrors.aliyun.com/pytorch-wheels/cpu/
# TORCH_VERSION=2.7.1+cpu

# Local React demo bypasses gateway auth and relies on BIND_HOST=127.0.0.1.
# DOC_API_KEYS is enforced only outside DOC_PROFILE=demo.
DOC_PROFILE=demo
DOC_API_KEYS=dev-key-1
DOC_API_KEY=dev-key-1

# Local model endpoint (for API + Streamlit containers)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Required for the real two-query smoke test
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional alternative cloud providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
GEMINI_API_KEY=

# Hugging Face cache/offline toggles
# Keep the two image-baked BGE snapshots immutable at runtime. Set to 0 only
# when deliberately switching models or refreshing the local cache.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
